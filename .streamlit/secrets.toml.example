# Copy to .streamlit/secrets.toml and fill in. Never commit the real file.

# Card reading from photos. Default "ocr" is free and offline (reads number / set code / slab label; you pick
# the condition on each draft). For AI identification + condition grading (~3-6p per card) use:
# VISION_BACKEND = "claude"
# ANTHROPIC_API_KEY = "sk-ant-..."

# eBay PRODUCTION keys (free developer account). Used for all price data (Browse API: free, 5,000 calls/day;
# sold prices are inferred from tracked listings that end sold) and for posting once EBAY_ENV = "production".
EBAY_APP_ID = "..."                    # developer.ebay.com -> Application Keys -> Production -> App ID (Client ID)
EBAY_CERT_ID = "..."                   # Cert ID (Client Secret)
EBAY_REFRESH_TOKEN = "v^1.1#..."       # User Tokens -> Production -> OAuth; scopes sell.inventory, sell.account, sell.fulfillment

# "production" posts real listings. "sandbox" posts to eBay's test site and needs the EBAY_SANDBOX_* keys below.
EBAY_ENV = "production"
# EBAY_SANDBOX_APP_ID = "..."
# EBAY_SANDBOX_CERT_ID = "..."
# EBAY_SANDBOX_REFRESH_TOKEN = "v^1.1#..."

# Optional: real SOLD prices. Free tier = 700 credits/month (~14 card fetches). Leave out to stay 100% free.
# SOLDCOMPS_KEY = "sh_live_..."

# Optional: email an address label when something sells (Settings -> Address labels). Gmail: turn on 2-step
# verification, then create an app password at myaccount.google.com/apppasswords and paste it here.
# SMTP_USER = "you@gmail.com"
# SMTP_PASSWORD = "abcd efgh ijkl mnop"
# LABEL_TO = "you@gmail.com"          # optional, defaults to SMTP_USER
# SMTP_HOST = "smtp.gmail.com"        # optional, other providers: their SMTP server (SSL, port 465)

# Optional: OCR CPU threads (default 4).
# OCR_THREADS = 4
